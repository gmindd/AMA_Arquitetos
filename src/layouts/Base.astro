---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import NavLateral from '../components/NavLateral.astro';
import Splash from '../components/Splash.astro';
import Footer from '../components/Footer.astro';
import { obterDefinicoes } from '../lib/store';
import { t, LOCALE_DEFAULT, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale: Locale = (Astro.locals as { locale?: Locale }).locale ?? LOCALE_DEFAULT;
const {
  title = t('site.tituloBase', locale),
  description = t('site.descricaoBase', locale),
} = Astro.props;

// Logótipos geridos no backoffice — influenciam cabeçalho, rodapé e favicon.
// Sem upload, usamos os SVG oficiais em /images/marca/:
//  - ama-mark.svg   → só "AMA", compacto para o cabeçalho
//  - ama-logo.svg   → lockup completo (AMA + subtítulo) para o rodapé
// Quando é carregado um logótipo no backoffice, esse ficheiro assume ambos.
const definicoes = await obterDefinicoes();
const logosCabecalho = {
  ...definicoes.logos,
  principal: definicoes.logos.principal ?? '/images/marca/ama-mark.svg',
};
const logosRodape = {
  ...definicoes.logos,
  principal: definicoes.logos.principal ?? '/images/marca/ama-logo.svg',
};
const favicon = definicoes.logos.icone ?? '/favicon.svg';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <ClientRouter />
    <script is:inline>
      // Executa síncrono antes do <body> pintar: se o splash já foi visto
      // nesta sessão, marca a raiz para que o CSS o esconda de imediato
      // e não haja lampejo em navegações internas.
      try {
        if (sessionStorage.getItem('ama-splash-visto')) {
          document.documentElement.classList.add('sem-splash');
        }
      } catch (_) {}
    </script>
    <script>
      import '../scripts/main.js';
    </script>
  </head>
  <body>
    <a class="salto-conteudo" href="#conteudo">{t('nav.saltarConteudo', locale)}</a>
    <Splash logo={logosRodape.principal} />
    <Header logos={logosCabecalho} locale={locale} />
    <NavLateral locale={locale} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer logos={logosRodape} locale={locale} />
  </body>
</html>
