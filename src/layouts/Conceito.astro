---
// Layout do site conceito AMA: uma prancheta de arquiteto.
// Réguas, mira do cursor e moldura da folha são fixos e acompanham toda
// a página; o conteúdo de cada página entra no <slot />.
import Rodape from '../components/conceito/Rodape.astro';
import '../styles/conceito.css';

interface Props {
  title?: string;
  description?: string;
  /** A página abre com a intro "André e Melissa Arquitetos" → AMA */
  intro?: boolean;
  /** Página ativa no menu */
  pagina?: 'inicio' | 'reabilitacao' | 'legal';
}

const {
  intro = false,
  pagina = 'inicio',
  title = 'AMA André Melissa Arquitetos · Tudo começa com uma linha',
  description = 'Gabinete de arquitetura em Viana do Castelo. Projeto, reabilitação e obra com equipa própria, do primeiro traço à entrega da chave.',
} = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6e4e0" />
    <link rel="icon" href="/favicon.svg" />
    <noscript><style>.alcado * { animation-play-state: running !important; }</style></noscript>
    {
      intro && (
        <script is:inline>
          // Decide antes de pintar se a intro corre: só ao abrir o site
          // (não ao voltar de outra página do site nem com âncora no URL).
          // Se o script principal não arrancar, a página nunca fica escondida.
          (function () {
            try {
              var nav = performance.getEntriesByType('navigation')[0];
              var interna = document.referrer && new URL(document.referrer).origin === location.origin && (!nav || nav.type !== 'reload');
              if (location.hash || interna) return;
              history.scrollRestoration = 'manual';
              var raiz = document.documentElement;
              raiz.classList.add('intro-ativa');
              setTimeout(function () {
                if (!window.__amaIntro) raiz.classList.remove('intro-ativa');
              }, 4000);
            } catch (e) {}
          })();
        </script>
      )
    }
    <script>
      import '../scripts/conceito/index.js';
    </script>
  </head>
  <body>
    <a class="salto" href="#conteudo">Saltar para o conteúdo</a>

    <!-- Prancheta: elementos fixos, puramente decorativos -->
    <div class="regua regua--topo" aria-hidden="true" data-regua="x"><span class="regua__marca"></span></div>
    <div class="regua regua--lado" aria-hidden="true" data-regua="y"><span class="regua__marca"></span></div>
    <div class="moldura" aria-hidden="true"></div>
    <div class="mira" aria-hidden="true">
      <span class="mira__h"></span>
      <span class="mira__v"></span>
      <span class="mira__leitura"></span>
    </div>

    <header class="topo">
      <!-- O logótipo AMA (o mesmo lettering de /images/marca/ama-mark.svg) em
           texto, letra a letra: é o destino exato das maiúsculas da intro -->
      <a class="topo__marca" href="/" aria-label="AMA, início">
        <span class="logo-ama" aria-hidden="true" data-logo-ama><span>A</span><span>M</span><span>A</span></span>
      </a>
      <nav class="topo__nav" aria-label="Secções">
        <a href="/#processo">Processo</a>
        <a href="/reabilitacao" aria-current={pagina === 'reabilitacao' ? 'page' : undefined}>Reabilitação</a>
        <a href="/#equipa">Equipa</a>
      </nav>
      <a class="topo__cta" href="/#contacto">Contactar</a>
    </header>


    <!-- Intro da página (fora do <main>, que fica escondido enquanto corre) -->
    <slot name="intro" />

    <main id="conteudo">
      <slot />
      <Rodape />
    </main>
  </body>
</html>
