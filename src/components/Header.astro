---
// Cabeçalho fixo (só usado em mobile agora): logótipo à esquerda, botão
// hamburger à direita e menu de ecrã inteiro. Em desktop o cabeçalho
// está oculto — a identidade vem do splash e do menu lateral.
import LogoMarca from './LogoMarca.astro';
import Bandeiras from './Bandeiras.astro';
import { t, hrefLocale, extrairLocale, type Locale } from '../lib/i18n';
import type { Definicoes } from '../lib/store';

interface Props {
  logos: Definicoes['logos'];
  locale: Locale;
}

const { logos, locale } = Astro.props;
const path = Astro.url.pathname;
const { pathSemLocale } = extrairLocale(path);

// Na home o cabeçalho flutua sobre a fotografia a ecrã inteiro:
// mistura por diferença garante legibilidade sobre qualquer imagem.
const sobreHero = pathSemLocale === '/';

const ligacoes = [
  { chave: 'nav.projetos', href: '/', ativo: pathSemLocale === '/' || pathSemLocale.startsWith('/projetos') },
  { chave: 'nav.reabilitacao', href: '/reabilitacao', ativo: pathSemLocale.startsWith('/reabilitacao') },
  { chave: 'nav.sobre', href: '/sobre', ativo: pathSemLocale.startsWith('/sobre') },
  { chave: 'nav.contactos', href: '/contactos', ativo: pathSemLocale.startsWith('/contactos') },
];
---

<header
  class={`cabecalho modo-translucido${sobreHero ? ' cabecalho--difusao' : ''}`}
  data-cabecalho
>
  <a class="marca" href={hrefLocale('/', locale)} aria-label={t('nav.paginaInicial', locale)}>
    <LogoMarca url={logos.principal} rotulo="AMA André Melissa Arquitetos" classe="marca__logo">
      <span class="marca__sigla">AMA</span>
      <span class="marca__nome">André Melissa<br />Arquitetos</span>
    </LogoMarca>
  </a>

  <button
    class="botao-menu"
    type="button"
    aria-label={t('nav.abrirMenu', locale)}
    aria-expanded="false"
    data-botao-menu
  >
    <span></span>
    <span></span>
  </button>

  <nav class="menu-total" aria-label={t('nav.projetos', locale)} data-menu>
    {ligacoes.map((l) => (
      <a href={hrefLocale(l.href, locale)} aria-current={l.ativo ? 'page' : undefined}>{t(l.chave, locale)}</a>
    ))}
    <a
      class="menu-total__cta"
      href={hrefLocale('/contactos', locale)}
      aria-current={pathSemLocale.startsWith('/contactos') ? 'page' : undefined}
    >{t('nav.enviarMensagem', locale)}</a>
    <Bandeiras locale={locale} extra="bandeiras--menu-total" />
    <div class="menu-total__pe">
      <span>Praia da Amorosa, Viana do Castelo</span>
      <span>Gabinete de arquitetura</span>
    </div>
  </nav>
</header>
