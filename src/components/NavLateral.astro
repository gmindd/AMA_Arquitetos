---
// Menu lateral (só desktop): coluna vertical à direita, alinhada em baixo.
// Fica fora do <header> para não herdar o backdrop-filter deste — que
// tornaria o cabeçalho num bloco contentor e ancoraria este menu ao topo.
// O menu usa sempre mistura por diferença: fica legível sobre qualquer
// fundo — fotografia clara, fotografia escura ou o bone da página —
// sem precisar de qualquer cromo. As bandeiras são um irmão fora do
// bloco com blend para não ficarem invertidas.
import Bandeiras from './Bandeiras.astro';
import { t, hrefLocale, extrairLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pathSemLocale } = extrairLocale(Astro.url.pathname);

const ligacoes = [
  { chave: 'nav.projetos', href: '/', ativo: pathSemLocale === '/' || pathSemLocale.startsWith('/projetos') },
  { chave: 'nav.reabilitacao', href: '/reabilitacao', ativo: pathSemLocale.startsWith('/reabilitacao') },
  { chave: 'nav.sobre', href: '/sobre', ativo: pathSemLocale.startsWith('/sobre') },
  { chave: 'nav.contactos', href: '/contactos', ativo: pathSemLocale.startsWith('/contactos') },
];
---

<div class="canto-lateral">
  <nav class="nav-lateral" aria-label={t('nav.projetos', locale)}>
    {ligacoes.map((l) => (
      <a href={hrefLocale(l.href, locale)} aria-current={l.ativo ? 'page' : undefined}>{t(l.chave, locale)}</a>
    ))}
    <a
      class="nav-lateral__cta"
      href={hrefLocale('/contactos', locale)}
      aria-current={pathSemLocale.startsWith('/contactos') ? 'page' : undefined}
    >{t('nav.enviarMensagem', locale)}</a>
  </nav>
  <Bandeiras locale={locale} extra="bandeiras--lateral" />
</div>
