---
// Campos do formulário de projeto, partilhados entre criar e editar.
// Cada campo textual traduzível tem uma linha por idioma (PT/EN/FR).
import type { Projeto } from '../../lib/store';
import CampoTraduzido from './CampoTraduzido.astro';

interface Props {
  projeto: Projeto | null;
}

const { projeto } = Astro.props;
---

<CampoTraduzido campo="titulo" rotulo="Título" valor={projeto?.titulo} obrigatorioPt />

<div class="par">
  <div>
    <CampoTraduzido
      campo="tipologia"
      rotulo="Tipologia"
      valor={projeto?.tipologia}
      obrigatorioPt
      dica="Ex.: Habitação unifamiliar, Reabilitação, Reconversão de espaço"
    />
  </div>
  <div>
    <CampoTraduzido
      campo="local"
      rotulo="Local"
      valor={projeto?.local}
      obrigatorioPt
      dica="Ex.: Chafé, Viana do Castelo"
    />
  </div>
</div>

<div class="par">
  <div>
    <CampoTraduzido campo="area" rotulo="Área" valor={projeto?.area} obrigatorioPt dica="Ex.: 84 m²" />
  </div>
  <div class="campo">
    <label for="ano">Ano</label>
    <input
      id="ano"
      name="ano"
      type="number"
      value={projeto?.ano ?? new Date().getFullYear()}
      required
    />
  </div>
</div>

<div class="campo">
  <label for="capa">Fotografia de capa</label>
  {projeto?.capa && (
    <div class="previa">
      <figure>
        <img src={projeto.capa} alt="Capa atual" />
      </figure>
    </div>
  )}
  <input id="capa" name="capa" type="file" accept="image/*" required={!projeto} />
  {projeto && <span class="dica">Enviar um ficheiro novo substitui a capa atual.</span>}
</div>

{projeto && projeto.galeria.length > 0 && (
  <div class="campo">
    <label>Galeria atual</label>
    <div class="previa">
      {projeto.galeria.map((imagem, i) => (
        <figure>
          <img src={imagem} alt={`Imagem ${i + 1} da galeria`} />
          <label>
            <input type="checkbox" name="galeria-remover" value={imagem} />
            Remover
          </label>
        </figure>
      ))}
    </div>
  </div>
)}

<div class="campo">
  <label for="galeria-novas">Adicionar imagens à galeria</label>
  <input id="galeria-novas" name="galeria-novas" type="file" accept="image/*" multiple />
</div>

<div class="par">
  <div class="campo">
    <label for="variacaoLogo">Posição do logótipo na capa</label>
    <select id="variacaoLogo" name="variacaoLogo">
      <option value="A/MA" selected={(projeto?.variacaoLogo ?? 'A/MA') === 'A/MA'}>Canto inferior direito</option>
      <option value="A/AM" selected={projeto?.variacaoLogo === 'A/AM'}>Canto superior direito</option>
      <option value="MA/A" selected={projeto?.variacaoLogo === 'MA/A'}>Canto inferior esquerdo</option>
    </select>
  </div>
  <div class="campo">
    <label for="ordem">Ordem na grelha</label>
    <input id="ordem" name="ordem" type="number" value={projeto?.ordem ?? 0} />
    <span class="dica">Números mais baixos aparecem primeiro.</span>
  </div>
</div>

<div class="campo">
  <label>
    <input type="checkbox" name="logoClaro" checked={projeto?.logoClaro ?? true} />
    Logótipo e legenda em branco (fotografia escura)
  </label>
  <span class="dica">Desligar para tinta preta sobre fotografia clara.</span>
</div>

<div class="campo">
  <label>
    <input type="checkbox" name="visivel" checked={projeto?.visivel ?? true} />
    Visível no site
  </label>
  <span class="dica">Desligar oculta o projeto do site sem o apagar.</span>
</div>

<CampoTraduzido
  campo="nota"
  rotulo="Nota breve (opcional)"
  valor={projeto?.nota}
  tipo="textarea"
  dica="Duas ou três frases curtas. O projeto é o protagonista."
/>
