---
// Campos do formulário de obra de reabilitação, partilhados entre criar e editar.
import type { Obra } from '../../lib/store';
import CampoTraduzido from './CampoTraduzido.astro';

interface Props {
  obra: Obra | null;
}

const { obra } = Astro.props;
---

<CampoTraduzido
  campo="titulo"
  rotulo="Título"
  valor={obra?.titulo}
  obrigatorioPt
  dica="Ex.: Tratamento de fachada de prédio"
/>

<div class="par">
  <div>
    <CampoTraduzido campo="local" rotulo="Local" valor={obra?.local} obrigatorioPt />
  </div>
  <div class="campo">
    <label for="ano">Ano</label>
    <input id="ano" name="ano" type="number" value={obra?.ano ?? new Date().getFullYear()} required />
  </div>
</div>

<div class="par">
  <div class="campo">
    <label for="antes">Fotografia — antes</label>
    {obra?.antes && (
      <div class="previa">
        <figure><img src={obra.antes} alt="Antes, atual" /></figure>
      </div>
    )}
    <input id="antes" name="antes" type="file" accept="image/*" required={!obra} />
  </div>
  <div class="campo">
    <label for="depois">Fotografia — depois</label>
    {obra?.depois && (
      <div class="previa">
        <figure><img src={obra.depois} alt="Depois, atual" /></figure>
      </div>
    )}
    <input id="depois" name="depois" type="file" accept="image/*" required={!obra} />
  </div>
</div>

<div class="campo">
  <label for="ordem">Ordem na lista</label>
  <input id="ordem" name="ordem" type="number" value={obra?.ordem ?? 0} />
</div>

<div class="campo">
  <label>
    <input type="checkbox" name="visivel" checked={obra?.visivel ?? true} />
    Visível no site
  </label>
  <span class="dica">Desligar oculta a obra do site sem a apagar.</span>
</div>

<CampoTraduzido campo="nota" rotulo="Nota breve (opcional)" valor={obra?.nota} tipo="textarea" />
