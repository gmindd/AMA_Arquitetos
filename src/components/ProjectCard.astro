---
// Cartão de projeto no mosaico: fotografia a sangrar, logótipo posicionado
// no canto escolhido e legenda em baixo — o cromo desaparece, o projeto é o
// protagonista.
import { cantoVariante } from '../lib/store';
interface Props {
  href: string;
  titulo: string;
  tipologia: string;
  ano: number;
  capa: string;
  variacaoLogo: 'A/MA' | 'A/AM' | 'MA/A';
  logoClaro: boolean;
  indice: number;
  varImg?: string;
}

const { href, titulo, tipologia, ano, capa, variacaoLogo, logoClaro, indice, varImg } = Astro.props;

const canto = cantoVariante(variacaoLogo);
---

<a class={`cartao ${logoClaro ? '' : 'cartao--tinta-escura'}`} href={href} data-canto={canto} data-reveal>
  <figure class="cartao__media">
    <!-- Substituir pelo ficheiro real do projeto via /admin ou public/images -->
    <img src={capa} alt={`${titulo}, ${tipologia}`} loading={indice < 2 ? 'eager' : 'lazy'} />
    {varImg ? (
      <span
        class="cartao__marca cartao__marca--img"
        data-canto={canto}
        style={`--logo:url('${varImg}')`}
        aria-hidden="true"
      />
    ) : (
      <span class="cartao__marca" data-canto={canto} aria-hidden="true">AMA</span>
    )}
    <span class="cartao__legenda">{titulo} · {ano}</span>
  </figure>
</a>
