---
// Cartão de projeto no mosaico: fotografia a sangrar, variação do logótipo
// e legenda sobrepostas — o cromo desaparece, o projeto é o protagonista.
interface Props {
  href: string;
  titulo: string;
  tipologia: string;
  ano: number;
  capa: string;
  variacaoLogo: 'A/MA' | 'A/AM' | 'MA/A';
  logoClaro: boolean;
  indice: number;
  varImg?: string;
}

const { href, titulo, tipologia, ano, capa, variacaoLogo, logoClaro, indice, varImg } = Astro.props;

// A variação composta divide-se em duas linhas empilhadas (ex.: A / MA)
const [linha1, linha2] = variacaoLogo.split('/');
---

<a class={`cartao ${logoClaro ? '' : 'cartao--tinta-escura'}`} href={href} data-reveal>
  <figure class="cartao__media">
    <!-- Substituir pelo ficheiro real do projeto via /admin ou public/images -->
    <img src={capa} alt={`${titulo}, ${tipologia}`} loading={indice < 2 ? 'eager' : 'lazy'} />
    {varImg ? (
      <span
        class="cartao__marca cartao__marca--img"
        style={`--logo:url('${varImg}')`}
        aria-hidden="true"
      />
    ) : (
      <span class="cartao__marca" aria-hidden="true">{linha1}<br />{linha2}</span>
    )}
    <span class="cartao__legenda">{titulo} · {ano}</span>
  </figure>
</a>
