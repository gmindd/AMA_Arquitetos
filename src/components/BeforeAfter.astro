---
// Comparador antes/depois: registo documental honesto, sem filtros.
// O input range invisível garante acessibilidade por teclado e leitor de ecrã.
interface Props {
  titulo: string;
  antes: string;
  depois: string;
  rotuloAntes?: string;
  rotuloDepois?: string;
}

const { titulo, antes, depois, rotuloAntes = 'Antes', rotuloDepois = 'Depois' } = Astro.props;
---

<div class="ba" data-ba>
  <img src={antes} alt={`${titulo} — ${rotuloAntes}`} loading="lazy" />
  <img class="ba__img--depois" src={depois} alt={`${titulo} — ${rotuloDepois}`} loading="lazy" />
  <div class="ba__linha" aria-hidden="true"></div>
  <span class="ba__etiqueta ba__etiqueta--antes" aria-hidden="true">{rotuloAntes}</span>
  <span class="ba__etiqueta ba__etiqueta--depois" aria-hidden="true">{rotuloDepois}</span>
  <input
    class="ba__range"
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`${rotuloAntes} / ${rotuloDepois} · ${titulo}`}
  />
</div>
