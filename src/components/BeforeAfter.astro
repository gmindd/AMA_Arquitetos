---
// Comparador antes/depois: registo documental honesto, sem filtros.
// O input range invisível garante acessibilidade por teclado e leitor de ecrã.
interface Props {
  titulo: string;
  antes: string;
  depois: string;
}

const { titulo, antes, depois } = Astro.props;
---

<div class="ba" data-ba>
  <img src={antes} alt={`${titulo} — antes da intervenção`} loading="lazy" />
  <img class="ba__img--depois" src={depois} alt={`${titulo} — depois da intervenção`} loading="lazy" />
  <div class="ba__linha" aria-hidden="true"></div>
  <span class="ba__etiqueta ba__etiqueta--antes" aria-hidden="true">Antes</span>
  <span class="ba__etiqueta ba__etiqueta--depois" aria-hidden="true">Depois</span>
  <input
    class="ba__range"
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`Comparar antes e depois — ${titulo}`}
  />
</div>
