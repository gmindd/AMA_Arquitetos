---
// Rodapé: sigla grande, morada, contactos, navegação e bio
import LogoMarca from './LogoMarca.astro';
import type { Definicoes } from '../lib/store';

interface Props {
  logos: Definicoes['logos'];
}

const { logos } = Astro.props;
const ano = new Date().getFullYear();
---

<footer class="rodape wrap">
  <LogoMarca url={logos.principal} rotulo="AMA — André Melissa Arquitetos" classe="rodape__logo">
    <p class="rodape__sigla" aria-hidden="true">AMA</p>
  </LogoMarca>

  <div class="rodape__colunas">
    <div>
      <span class="rotulo">Morada</span>
      <p>
        Avenida do Atlântico 221, loja 10<br />
        4935-580 Chafé<br />
        Praia da Amorosa, Viana do Castelo
      </p>
    </div>
    <div>
      <span class="rotulo">Contactos</span>
      <p>
        André Machado — <a href="tel:+351917091338">917 091 338</a><br />
        Melissa Fazendeiro — <a href="tel:+351918133120">918 133 120</a><br />
        <a href="mailto:andremelissaarquitetos@gmail.com">andremelissaarquitetos@gmail.com</a><br />
        <a href="https://www.instagram.com/andremelissaarquitetos" rel="noopener" target="_blank">@andremelissaarquitetos</a>
      </p>
    </div>
    <div>
      <span class="rotulo">Navegação</span>
      <p>
        <a href="/">Projetos</a><br />
        <a href="/reabilitacao">Reabilitação</a><br />
        <a href="/sobre">Sobre</a><br />
        <a href="/contactos">Contactos</a>
      </p>
    </div>
    <div>
      <span class="rotulo">AMA</span>
      <p class="rodape__bio">
        Gabinete de arquitetura em Viana do Castelo. Habitação, interiores e
        reconversão de espaços. Reabilitações e tratamento de fachadas com
        equipa própria. Um só interlocutor, do projeto à obra.
      </p>
    </div>
  </div>

  <div class="rodape__base">
    <span>© {ano} AMA — André Melissa Arquitetos</span>
    <span>41.6448° N, 8.8236° O — Praia da Amorosa</span>
    <a href="https://www.pereiragabriel.com/" rel="noopener" target="_blank">crafted by pereiragabriel</a>
  </div>
</footer>
