---
// Rodapé: sigla grande, morada, contactos, navegação e bio
import LogoMarca from './LogoMarca.astro';
import { t, hrefLocale, type Locale } from '../lib/i18n';
import type { Definicoes } from '../lib/store';

interface Props {
  logos: Definicoes['logos'];
  locale: Locale;
}

const { logos, locale } = Astro.props;
const ano = new Date().getFullYear();
---

<footer class="rodape wrap">
  <LogoMarca url={logos.principal} rotulo="AMA André Melissa Arquitetos" classe="rodape__logo">
    <p class="rodape__sigla" aria-hidden="true">AMA</p>
  </LogoMarca>

  <div class="rodape__colunas">
    <div>
      <span class="rotulo">{t('rodape.morada', locale)}</span>
      <p>
        Avenida do Atlântico 221, loja 10<br />
        4935-580 Chafé<br />
        Praia da Amorosa, Viana do Castelo
      </p>
    </div>
    <div>
      <span class="rotulo">{t('rodape.contactos', locale)}</span>
      <p>
        André Machado · <a href="tel:+351917091338">917 091 338</a><br />
        Melissa Fazendeiro · <a href="tel:+351918133120">918 133 120</a><br />
        <a href="mailto:andremelissaarquitetos@gmail.com">andremelissaarquitetos@gmail.com</a><br />
        <a href="https://www.instagram.com/andremelissaarquitetos" rel="noopener" target="_blank">@andremelissaarquitetos</a>
      </p>
    </div>
    <div>
      <span class="rotulo">{t('rodape.navegacao', locale)}</span>
      <p>
        <a href={hrefLocale('/', locale)}>{t('nav.projetos', locale)}</a><br />
        <a href={hrefLocale('/reabilitacao', locale)}>{t('nav.reabilitacao', locale)}</a><br />
        <a href={hrefLocale('/sobre', locale)}>{t('nav.sobre', locale)}</a><br />
        <a href={hrefLocale('/contactos', locale)}>{t('nav.contactos', locale)}</a>
      </p>
    </div>
    <div>
      <span class="rotulo">{t('rodape.ama', locale)}</span>
      <p class="rodape__bio">{t('rodape.bio', locale)}</p>
    </div>
  </div>

  <div class="rodape__base">
    <span>{t('rodape.copyright', locale).replace('{ano}', String(ano))}</span>
    <span>{t('rodape.coords', locale)}</span>
    <a href="https://www.pereiragabriel.com/" rel="noopener" target="_blank">{t('rodape.crafted', locale)}</a>
  </div>
</footer>
