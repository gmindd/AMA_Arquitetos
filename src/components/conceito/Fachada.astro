---
import FachadaBase from './FachadaBase.astro';
// Alçado de um prédio do centro histórico de Viana, desenhado a traço:
// à esquerda o levantamento (fissuras, reboco e azulejo em falta), à
// direita a mesma fachada reabilitada. Uma linha arrastável separa os
// dois estados. Sem fotografias: só desenho.
const balaustres = (x0: number, x1: number, falhas: number[] = []) => {
  let d = '';
  let k = 0;
  for (let x = x0 + 4; x <= x1 - 3; x += 7, k++) {
    if (!falhas.includes(k)) d += `M${x} 366 V395 `;
  }
  return d;
};
const vaosX = [35, 145, 255];
---

<div class="fachada" data-fachada>
  <svg class="fachada__svg" viewBox="0 30 760 580" role="img" aria-labelledby="fachada-titulo">
    <title id="fachada-titulo">Alçado de um prédio antes e depois da reabilitação</title>
    <defs>
      <pattern id="fa-azulejo" width="14" height="14" patternUnits="userSpaceOnUse">
        <rect width="14" height="14" class="fa-azulejo__junta" />
        <path d="M7 2 L12 7 L7 12 L2 7 Z" class="fa-azulejo__motivo" />
      </pattern>
      <pattern id="fa-tracado" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V6" class="fa-tracado" />
      </pattern>

      <clipPath id="fa-corte">
        <rect x="380" y="0" width="760" height="620" data-corte />
      </clipPath>
    </defs>

    <!-- Antes: levantamento com patologias -->
    <g class="fachada__antes">
      <g transform="translate(210 10)">
        <FachadaBase />
        <path class="fa-fino" d={vaosX.map((x, i) => balaustres(x - 10, x + 60, i === 2 ? [1, 2, 6] : i === 0 ? [4] : [])).join(' ')} />
        <path class="papel fa-patologia" d="M20 150 L48 142 L60 170 L40 196 L14 184 Z M98 300 L130 290 L142 330 L118 352 L96 338 Z M300 112 L330 108 L336 150 L310 160 Z M60 432 L110 430 L104 452 L66 456 Z" />
        <path class="fa-patologia-tracado" d="M20 150 L48 142 L60 170 L40 196 L14 184 Z M98 300 L130 290 L142 330 L118 352 L96 338 Z M300 112 L330 108 L336 150 L310 160 Z M60 432 L110 430 L104 452 L66 456 Z" fill="url(#fa-tracado)" />
        <path class="fa-fissura" d="M88 296 l6 -14 l-4 -10 l8 -16 l-3 -12 M195 401 l10 18 l-4 8 l12 12 M300 236 l8 10 l-2 12 l10 6 M150 470 l-10 -18 l4 -10 l-8 -14 M232 140 l-8 -14 l4 -10 l-6 -12" />
        <path class="fa-fino tracejado" d="M40 402 V440 M62 402 V456 M150 402 V432 M176 402 V448 M262 402 V438 M286 402 V452" />
        <path class="fa-fino" d="M145 140 L170 180 M262 298 L282 330 M40 476 L70 520" />
        <path class="papel" d="M255 140 L280 136 L284 236 L259 238 Z" />
        <path class="fa-fino" d="M256 152 L281 149 M257 166 L281 163 M257 180 L282 177 M258 194 L282 191 M258 208 L283 205 M258 222 L283 219" />
        <path class="fa-fino" d="M320 86 q-6 -14 4 -20 M326 86 q4 -12 12 -12 M314 86 q-10 -6 -12 -14" />
      </g>
      <g class="fachada__notas">
        <path class="fa-fino" d="M150 296 H230 L298 292" /><circle cx="298" cy="292" r="3" />
        <text x="20" y="300">Fissuras</text>
        <path class="fa-fino" d="M150 172 H210 L246 178" /><circle cx="246" cy="178" r="3" />
        <text x="20" y="176">Azulejo em falta</text>
        <path class="fa-fino" d="M168 516 H230 L285 520" /><circle cx="285" cy="520" r="3" />
        <text x="20" y="520">Caixilharia gasta</text>
      </g>
    </g>

    <!-- Depois: a mesma fachada reabilitada -->
    <g class="fachada__depois" clip-path="url(#fa-corte)">
      <rect class="papel-fundo" x="0" y="0" width="760" height="620" />
      <g transform="translate(210 10)">
        <FachadaBase />
        <path class="fa-fino" d={vaosX.map((x) => balaustres(x - 10, x + 60)).join(' ')} />
        <path class="fa-fino" d={vaosX.map((x) => `M${x + 4} 299 h42 v92 h-42 Z M${x + 4} 144 h42 v87 h-42 Z`).join(' ')} />
        <path class="fa-fino" d="M34 474 h82 v82 h-82 Z M224 474 h82 v82 h-82 Z" />
        <path d="M222 500 h8 v12 h-8 Z M226 494 V500" />
      </g>
      <g class="fachada__notas">
        <path class="fa-fino" d="M610 196 H560 L530 190" /><circle cx="530" cy="190" r="3" />
        <text x="620" y="200">Azulejo recuperado</text>
        <path class="fa-fino" d="M610 356 H560 L515 355" /><circle cx="515" cy="355" r="3" />
        <text x="620" y="360">Caixilharia nova</text>
        <path class="fa-fino" d="M610 416 H560 L512 408" /><circle cx="512" cy="408" r="3" />
        <text x="620" y="420">Varandas restauradas</text>
      </g>
    </g>
  </svg>

  <span class="fachada__tag fachada__tag--antes">Antes</span>
  <span class="fachada__tag fachada__tag--depois">Depois</span>

  <div class="fachada__linha" data-linha style="--corte:50%">
    <button
      class="fachada__pega"
      type="button"
      role="slider"
      aria-label="Comparar antes e depois"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      data-pega
    >
      <span aria-hidden="true"></span>
    </button>
  </div>
</div>
