---
import Base from '../layouts/Base.astro';
import { t, LOCALE_DEFAULT, type Locale } from '../lib/i18n';

const locale: Locale = (Astro.locals as { locale?: Locale }).locale ?? LOCALE_DEFAULT;
---

<Base title={t('sobre.tituloPagina', locale)}>
  <h1 class="titulo-pagina wrap" data-reveal>{t('sobre.titulo', locale)}</h1>

  <section class="sobre wrap">
    <div class="sobre__texto">
      <p data-reveal>{t('sobre.paragrafo1', locale)}</p>
      <p class="assinatura" data-reveal>{t('sobre.assinatura', locale)}</p>
      <p data-reveal>{t('sobre.paragrafo2', locale)}</p>
    </div>

    <figure class="sobre__foto" data-reveal>
      <!-- Substituir pela fotografia real: public/images/sobre/fundadores.jpg -->
      <img src="/images/sobre/fundadores.svg" alt={t('sobre.fotoAlt', locale)} />
      <figcaption>{t('sobre.fotoLegenda', locale)}</figcaption>
    </figure>
  </section>
</Base>
