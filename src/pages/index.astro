---
import { listarProjetosPublicos, obterDefinicoes, chaveVariante } from '../lib/store';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Home = grelha de projetos visíveis, sem texto de abertura.
const projetos = await listarProjetosPublicos();
const { logos } = await obterDefinicoes();

// Variante de logótipo a sobrepor na capa de cada projeto (se carregada)
const variante = (v: 'A/MA' | 'A/AM' | 'MA/A') => logos[chaveVariante(v)];
---

<Base>
  <h1 class="oculto">Projetos · AMA André Melissa Arquitetos</h1>

  <!-- Abertura a ecrã inteiro: os projetos em rotação lenta, sem texto de abertura -->
  <section class="hero" data-hero aria-label="Projetos em destaque">
    {projetos.map((p, i) => (
      <a
        class={`hero__slide${i === 0 ? ' ativo' : ''}`}
        href={`/projetos/${p.slug}`}
        data-hero-slide
        tabindex={i === 0 ? undefined : -1}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <img
          src={p.capa}
          alt={`${p.titulo}, ${p.tipologia}`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        <p class="hero__legenda">{p.titulo} · {p.local}, {p.ano}</p>
      </a>
    ))}
    <button class="hero__seta" type="button" data-hero-seta aria-label="Ver todos os projetos">
      ↓
    </button>
  </section>

  <section class="grelha-projetos" id="projetos" aria-label="Projetos">
    {projetos.map((p, i) => (
      <ProjectCard
        href={`/projetos/${p.slug}`}
        titulo={p.titulo}
        tipologia={p.tipologia}
        ano={p.ano}
        capa={p.capa}
        variacaoLogo={p.variacaoLogo}
        logoClaro={p.logoClaro}
        indice={i}
        varImg={variante(p.variacaoLogo)}
      />
    ))}
  </section>
</Base>
