---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Home = grelha de projetos, sem texto de abertura. Logótipo e menu bastam.
const projetos = (await getCollection('projetos')).sort(
  (a, b) => a.data.ordem - b.data.ordem || b.data.ano - a.data.ano
);
---

<Base>
  <h1 class="oculto">Projetos — AMA, André Melissa Arquitetos</h1>

  <!-- Abertura a ecrã inteiro: os projetos em rotação lenta, sem texto de abertura -->
  <section class="hero" data-hero aria-label="Projetos em destaque">
    {projetos.map((p, i) => (
      <a
        class={`hero__slide${i === 0 ? ' ativo' : ''}`}
        href={`/projetos/${p.id}`}
        data-hero-slide
        tabindex={i === 0 ? undefined : -1}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <img
          src={p.data.capa}
          alt={`${p.data.titulo} — ${p.data.tipologia}`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        <p class="hero__legenda">{p.data.titulo} — {p.data.local}, {p.data.ano}</p>
      </a>
    ))}
    <button class="hero__seta" type="button" data-hero-seta aria-label="Ver todos os projetos">
      ↓
    </button>
  </section>

  <section class="grelha-projetos" id="projetos" aria-label="Projetos">
    {projetos.map((p, i) => (
      <ProjectCard
        href={`/projetos/${p.id}`}
        titulo={p.data.titulo}
        tipologia={p.data.tipologia}
        ano={p.data.ano}
        capa={p.data.capa}
        variacaoLogo={p.data.variacaoLogo}
        logoClaro={p.data.logoClaro}
        indice={i}
      />
    ))}
  </section>
</Base>
