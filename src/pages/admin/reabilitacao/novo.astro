---
import Admin from '../../../layouts/Admin.astro';
import CamposObra from '../../../components/admin/CamposObra.astro';
import { guardarObra } from '../../../lib/store';
import { obraDeFormulario, validarObra } from '../../../lib/forms';

let erros: string[] = [];

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  const obra = await obraDeFormulario(dados, null);
  erros = validarObra(obra);
  if (erros.length === 0) {
    await guardarObra(obra);
    return Astro.redirect('/admin', 303);
  }
}
---

<Admin title="Nova obra — Gestão de conteúdos AMA">
  <h1>Nova obra de reabilitação</h1>
  {erros.length > 0 && (
    <div class="aviso">
      {erros.map((e) => <p>{e}</p>)}
    </div>
  )}
  <form class="admin-form" method="POST" enctype="multipart/form-data">
    <CamposObra obra={null} />
    <div class="admin-acoes">
      <button class="cta" type="submit">Publicar obra</button>
      <a class="botao-apagar" href="/admin">Cancelar</a>
    </div>
  </form>
</Admin>
