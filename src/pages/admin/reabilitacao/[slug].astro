---
import Admin from '../../../layouts/Admin.astro';
import CamposObra from '../../../components/admin/CamposObra.astro';
import { obterObra, guardarObra, apagar } from '../../../lib/store';
import { obraDeFormulario, validarObra } from '../../../lib/forms';

let obra = await obterObra(Astro.params.slug ?? '');
if (!obra) {
  return Astro.rewrite('/404');
}

let erros: string[] = [];

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  if (dados.get('acao') === 'apagar') {
    await apagar('reabilitacao', obra.slug);
    return Astro.redirect('/admin', 303);
  }
  const atualizada = await obraDeFormulario(dados, obra);
  erros = validarObra(atualizada);
  if (erros.length === 0) {
    await guardarObra(atualizada);
    return Astro.redirect('/admin', 303);
  }
  obra = atualizada;
}
---

<Admin title={`${obra.titulo} — Gestão de conteúdos AMA`}>
  <h1>Editar obra de reabilitação</h1>
  {erros.length > 0 && (
    <div class="aviso">
      {erros.map((e) => <p>{e}</p>)}
    </div>
  )}
  <form class="admin-form" method="POST" enctype="multipart/form-data">
    <CamposObra obra={obra} />
    <div class="admin-acoes">
      <button class="cta" type="submit">Guardar alterações</button>
      <a class="botao-apagar" href="/reabilitacao" rel="noopener" target="_blank">Ver no site</a>
    </div>
  </form>

  <!-- Apagar é um formulário separado com confirmação no browser -->
  <form method="POST" data-confirmar="Apagar esta obra de forma definitiva?">
    <input type="hidden" name="acao" value="apagar" />
    <div class="admin-acoes">
      <button class="botao-apagar" type="submit">Apagar obra</button>
    </div>
  </form>
</Admin>
