---
import Admin from '../../layouts/Admin.astro';
import { obterDefinicoes, guardarDefinicoes, type Envio } from '../../lib/store';
import { envioDisponivel } from '../../lib/email';

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  const atual = await obterDefinicoes();

  const emailDestino = String(dados.get('emailDestino') ?? '').trim();
  const remetente = String(dados.get('remetente') ?? '').trim();
  const novaChave = String(dados.get('resendApiKey') ?? '').trim();
  const removerChave = dados.get('remover_chave') === 'on';

  // Determina a configuração de envio (Resend)
  let envio: Envio | undefined = atual.envio;
  if (removerChave) {
    envio = undefined;
  } else if (novaChave) {
    envio = { provedor: 'resend', apiKey: novaChave, remetente: remetente || undefined };
  } else if (envio) {
    envio = { ...envio, remetente: remetente || undefined };
  }

  await guardarDefinicoes({
    ...atual,
    emailDestino: emailDestino || undefined,
    envio,
  });
  return Astro.redirect('/admin/definicoes?ok=1', 303);
}

const definicoes = await obterDefinicoes();
const configurado = Boolean(definicoes.envio?.apiKey);
const pronto = envioDisponivel(definicoes);
const guardado = Astro.url.searchParams.has('ok');
---

<Admin title="Definições · Gestão de conteúdos AMA">
  <h1>Definições</h1>

  {guardado && <div class="aviso">Alterações guardadas.</div>}

  <h2>Envio de alertas (Resend)</h2>
  <p class="dica" style="max-width:48rem">
    Os pedidos do formulário são enviados por email através do Resend. Cria uma
    conta gratuita em <a href="https://resend.com" rel="noopener" target="_blank">resend.com</a>,
    gera uma chave de API e cola-a abaixo. Podes reconfigurar quando quiseres.
  </p>

  <form class="admin-form" method="POST">
    <div class="campo">
      <label for="resendApiKey">Chave de API do Resend</label>
      <input
        id="resendApiKey"
        name="resendApiKey"
        type="password"
        autocomplete="off"
        placeholder={configurado ? '•••••••• (configurada)' : 're_...'}
      />
      <span class="dica">
        {configurado
          ? 'Deixa em branco para manter a chave atual.'
          : 'Cola aqui a chave gerada no Resend (começa por re_).'}
      </span>
    </div>

    {configurado && (
      <div class="campo">
        <label>
          <input type="checkbox" name="remover_chave" /> Remover a chave (desativa o envio)
        </label>
      </div>
    )}

    <div class="campo">
      <label for="remetente">Remetente (opcional)</label>
      <input
        id="remetente"
        name="remetente"
        type="text"
        value={definicoes.envio?.remetente ?? ''}
        placeholder="AMA <onboarding@resend.dev>"
      />
      <span class="dica">
        Enquanto não verificarem um domínio no Resend, deixem em branco (usa
        onboarding@resend.dev). Depois de verificarem, ex.: AMA &lt;obras@andremelissaarquitetos.pt&gt;.
      </span>
    </div>

    <div class="campo">
      <label for="emailDestino">Email de destino</label>
      <input
        id="emailDestino"
        name="emailDestino"
        type="email"
        value={definicoes.emailDestino ?? ''}
        placeholder="andremelissaarquitetos@gmail.com"
      />
      <span class="dica">
        Para onde seguem os pedidos. Com o remetente de teste do Resend, tem de
        ser o email usado para criar a conta Resend.
      </span>
    </div>

    <div class="aviso" style="max-width:48rem">
      <strong>Estado do envio:</strong>
      {pronto ? ' pronto a enviar.' : ' ainda não configurado — os pedidos ficam guardados no servidor.'}
    </div>

    <div class="admin-acoes">
      <button class="cta" type="submit">Guardar</button>
      <a class="botao-apagar" href="/admin">Voltar</a>
    </div>
  </form>
</Admin>
