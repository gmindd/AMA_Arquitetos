---
import { listarProjetosPublicos, resolverProjeto } from '../../lib/store';
import Base from '../../layouts/Base.astro';
import { t, LOCALE_DEFAULT, hrefLocale, type Locale } from '../../lib/i18n';

const locale: Locale = (Astro.locals as { locale?: Locale }).locale ?? LOCALE_DEFAULT;

const projetosRaw = await listarProjetosPublicos();
const indice = projetosRaw.findIndex((p) => p.slug === Astro.params.slug);

if (indice === -1) {
  return Astro.rewrite('/404');
}

const projeto = resolverProjeto(projetosRaw[indice], locale);
const anterior = projetosRaw[indice - 1] ? resolverProjeto(projetosRaw[indice - 1], locale) : null;
const seguinte = projetosRaw[indice + 1] ? resolverProjeto(projetosRaw[indice + 1], locale) : null;
---

<Base
  title={`${projeto.titulo} · AMA André Melissa Arquitetos`}
  description={`${projeto.tipologia}. ${projeto.local}. ${projeto.area}. ${projeto.ano}.`}
>
  <article>
    <header class="projeto-topo wrap">
      <h1 data-reveal>{projeto.titulo}</h1>

      <!-- Ficha técnica: Tipologia · Local · Área · Ano -->
      <dl class="ficha" data-reveal>
        <div><dt>{t('projeto.tipologia', locale)}</dt><dd>{projeto.tipologia}</dd></div>
        <div><dt>{t('projeto.local', locale)}</dt><dd>{projeto.local}</dd></div>
        <div><dt>{t('projeto.area', locale)}</dt><dd>{projeto.area}</dd></div>
        <div><dt>{t('projeto.ano', locale)}</dt><dd>{projeto.ano}</dd></div>
      </dl>
    </header>

    <figure class="projeto-hero" data-reveal>
      <img src={projeto.capa} alt={`${projeto.titulo}, ${projeto.tipologia}`} data-parallax />
    </figure>

    <div class="projeto-corpo wrap">
      {projeto.nota.length > 0 && (
        <div class="nota" data-reveal>
          <p>{projeto.nota}</p>
        </div>
      )}

      {projeto.galeria.length > 0 && (
        <div class="galeria">
          {projeto.galeria.map((imagem, i) => (
            <figure data-reveal>
              <img src={imagem} alt={`${projeto.titulo}, ${t('projeto.imagemN', locale)} ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
    </div>

    <nav class="projeto-nav wrap" aria-label={t('projeto.outrosProjetos', locale)}>
      {anterior && (
        <a href={hrefLocale(`/projetos/${anterior.slug}`, locale)} data-sentido="anterior">
          <span class="rotulo">{t('projeto.anterior', locale)}</span>
          <strong>{anterior.titulo}</strong>
        </a>
      )}
      {seguinte && (
        <a href={hrefLocale(`/projetos/${seguinte.slug}`, locale)} data-sentido="seguinte">
          <span class="rotulo">{t('projeto.seguinte', locale)}</span>
          <strong>{seguinte.titulo}</strong>
        </a>
      )}
    </nav>
  </article>
</Base>
