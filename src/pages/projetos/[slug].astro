---
import { listarProjetosPublicos } from '../../lib/store';
import Base from '../../layouts/Base.astro';

const projetos = await listarProjetosPublicos();
const indice = projetos.findIndex((p) => p.slug === Astro.params.slug);

if (indice === -1) {
  return Astro.rewrite('/404');
}

const projeto = projetos[indice];
const anterior = projetos[indice - 1] ?? null;
const seguinte = projetos[indice + 1] ?? null;
const nota = projeto.nota?.trim() ?? '';
---

<Base
  title={`${projeto.titulo} — AMA | André Melissa Arquitetos`}
  description={`${projeto.tipologia}. ${projeto.local}. ${projeto.area}. ${projeto.ano}.`}
>
  <article>
    <header class="projeto-topo wrap">
      <h1 data-reveal>{projeto.titulo}</h1>

      <!-- Ficha técnica: Tipologia · Local · Área · Ano -->
      <dl class="ficha" data-reveal>
        <div><dt>Tipologia</dt><dd>{projeto.tipologia}</dd></div>
        <div><dt>Local</dt><dd>{projeto.local}</dd></div>
        <div><dt>Área</dt><dd>{projeto.area}</dd></div>
        <div><dt>Ano</dt><dd>{projeto.ano}</dd></div>
      </dl>
    </header>

    <figure class="projeto-hero" data-reveal>
      <img src={projeto.capa} alt={`${projeto.titulo} — ${projeto.tipologia}`} data-parallax />
    </figure>

    <div class="projeto-corpo wrap">
      {nota.length > 0 && (
        <div class="nota" data-reveal>
          <p>{nota}</p>
        </div>
      )}

      {projeto.galeria.length > 0 && (
        <div class="galeria">
          {projeto.galeria.map((imagem, i) => (
            <figure data-reveal>
              <img src={imagem} alt={`${projeto.titulo} — imagem ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
    </div>

    <nav class="projeto-nav wrap" aria-label="Outros projetos">
      {anterior && (
        <a href={`/projetos/${anterior.slug}`} data-sentido="anterior">
          <span class="rotulo">Anterior</span>
          <strong>{anterior.titulo}</strong>
        </a>
      )}
      {seguinte && (
        <a href={`/projetos/${seguinte.slug}`} data-sentido="seguinte">
          <span class="rotulo">Seguinte</span>
          <strong>{seguinte.titulo}</strong>
        </a>
      )}
    </nav>
  </article>
</Base>
