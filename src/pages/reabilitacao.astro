---
import { listarObrasPublicas, resolverObra } from '../lib/store';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { t, LOCALE_DEFAULT, hrefLocale, type Locale } from '../lib/i18n';

const locale: Locale = (Astro.locals as { locale?: Locale }).locale ?? LOCALE_DEFAULT;

const obrasRaw = await listarObrasPublicas();
const obras = obrasRaw.map((o) => resolverObra(o, locale));
---

<Base
  title={t('reabilitacao.tituloPagina', locale)}
  description={t('reabilitacao.descricao', locale)}
>
  <h1 class="titulo-pagina wrap" data-reveal>{t('reabilitacao.titulo', locale)}</h1>

  <p class="intro-seccao wrap" data-reveal>{t('reabilitacao.intro', locale)}</p>

  <section class="lista-reabilitacao wrap" aria-label={t('reabilitacao.titulo', locale)}>
    {obras.map((obra) => (
      <article data-reveal>
        <div class="obra__meta">
          <h2>{obra.titulo}</h2>
          <span>{obra.local} · {obra.ano}</span>
        </div>
        <BeforeAfter
          titulo={obra.titulo}
          antes={obra.antes}
          depois={obra.depois}
          rotuloAntes={t('reabilitacao.antes', locale)}
          rotuloDepois={t('reabilitacao.depois', locale)}
        />
        {obra.nota.length > 0 && (
          <p class="obra__nota">{obra.nota}</p>
        )}
      </article>
    ))}
  </section>
</Base>
