---
import { listarObrasPublicas } from '../lib/store';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';

const obras = await listarObrasPublicas();
---

<Base
  title="Reabilitação · AMA André Melissa Arquitetos"
  description="Fachadas, condomínios e reabilitações executadas pela equipa de construção própria do gabinete. Registo antes e depois."
>
  <h1 class="titulo-pagina wrap" data-reveal>Reabilitação</h1>

  <p class="intro-seccao wrap" data-reveal>
    Fachadas, condomínios e reabilitações executadas pela equipa de construção
    própria do gabinete. Quem desenha é quem executa.
  </p>

  <section class="lista-reabilitacao wrap" aria-label="Obras de reabilitação">
    {obras.map((obra) => (
      <article data-reveal>
        <div class="obra__meta">
          <h2>{obra.titulo}</h2>
          <span>{obra.local} · {obra.ano}</span>
        </div>
        <BeforeAfter titulo={obra.titulo} antes={obra.antes} depois={obra.depois} />
        {(obra.nota?.trim().length ?? 0) > 0 && (
          <p class="obra__nota">{obra.nota!.trim()}</p>
        )}
      </article>
    ))}
  </section>
</Base>
