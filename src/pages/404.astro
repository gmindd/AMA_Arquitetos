---
import Conceito from '../layouts/Conceito.astro';
---

<Conceito title="Folha não encontrada · AMA">
  <section class="abertura" data-folha="404" data-fase="Folha não encontrada">
    <div class="abertura__texto">
      <p class="sobretitulo">Erro 404</p>
      <h1 class="abertura__titulo">Esta folha ficou por desenhar.</h1>
      <p class="abertura__lead">A página que procura não existe ou mudou de lugar.</p>
      <p style="margin-top:2rem"><a class="botao" href="/">Voltar ao início</a></p>
    </div>
  </section>
</Conceito>
